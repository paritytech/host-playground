{
  "env": {
    "PATH": "/opt/homebrew/bin:/Users/tiago/.bun/bin:/Users/tiago/.nvm/versions/node/v22.13.1/bin:/Users/tiago/.pyenv/versions/3.11.8/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin"
  },
  "permissions": {
    "allow": [
      "Bash(yarn typecheck)",
      "Bash(yarn lint)",
      "Bash(yarn lint:fix)",
      "Bash(yarn test:*)",
      "Bash(yarn install:*)",
      "Bash(yarn build:*)",
      "Bash(yarn dev:*)",
      "Bash(forge build:*)",
      "Bash(forge test:*)",
      "Bash(npx papi:*)",
      "Bash(npm view:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(gh:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run watch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(npx bulletin-deploy *)",
      "Bash(export MNEMONIC='bottom drive obey lake curtain smoke basket hold race lonely fit walk')",
      "Bash(bulletin-deploy --unpublish host-playground.dot --env paseo-next-v2)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Session started at $(date). Branch: $(git branch --show-current 2>/dev/null || echo 'N/A'). Last commit: $(git log --oneline -1 2>/dev/null || echo 'N/A').\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"If there is remaining work, keep going. Check your task list.\""
          }
        ]
      }
    ]
  }
}
